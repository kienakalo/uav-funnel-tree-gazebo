# Local environments, bytecode and temporary application files.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# Obsidian vault metadata kept by local editors.
.obsidian/
.env
.env.*
!.env.example
*.log
*.pid
.DS_Store
Thumbs.db

# The city asset is tracked once, at data/raw/scenes/city.glb. Copies downloaded
# into the raw/meshes location stay local.
/data/raw/meshes/city.glb

# Derived scene rebuilt by tools/standardize.py (about 6 MB).
/data/processed/scenes/city.standardized.glb

# Stage output: previews, demo mission and its cache. Everything here is
# regenerated by "python3 main.py data"; only the README is kept.
/generated/**
!/generated/README.md
